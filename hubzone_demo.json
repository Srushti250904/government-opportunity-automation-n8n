      "parameters": {
        "jsCode": "const allowedNAICS = [\n  \"541511\",\n  \"541512\",\n  \"541513\",\n  \"541519\",\n  \"511210\",\n  \"519290\",\n  \"518210\",\n  \"513210\" // ✅ IMPORTANT (new SAM.gov code)\n];\n\nreturn items.filter(item => {\n  const type = item.json.type?.toLowerCase() || \"\";\n\n  // ✅ extract NAICS code from array\n  const naicsArray = item.json.naics || [];\n  const naicsCode = naicsArray[0]?.code || \"\";\n\n  const isBiddable = type.includes(\"solicitation\");\n  const isCorrectNAICS = allowedNAICS.includes(naicsCode);\n\n  return isBiddable && isCorrectNAICS;\n});"
      },
