    {
      "parameters": {
        "jsCode": "let rawData = items[0].json.data;\n\nif (!rawData) return [];\n\nlet parsedData = JSON.parse(rawData);\nlet results = parsedData._embedded?.results || [];\n\n// ✅ IT NAICS Codes (UPDATED)\nconst IT_NAICS = [\n  \"541511\",\n  \"541512\",\n  \"541513\",\n  \"541519\",\n  \"518210\",\n  \"513210\" // ✅ software publishers\n];\n\n// ✅ IT Keywords\nconst IT_KEYWORDS = [\n  \"software\",\n  \"cloud\",\n  \"cyber\",\n  \"data\",\n  \"ai\",\n  \"machine learning\",\n  \"it support\",\n  \"network\",\n  \"system\",\n  \"application\",\n  \"saas\",\n  \"devops\",\n  \"security\",\n  \"database\"\n];\n\n// ✅ NON-IT Keywords (NEW 🔥)\nconst NON_IT_KEYWORDS = [\n  \"construction\",\n  \"gasket\",\n  \"valve\",\n  \"mechanical\",\n  \"hardware\",\n  \"building\",\n  \"repair\",\n  \"maintenance\",\n  \"equipment\",\n  \"tractor\",\n  \"pump\",\n  \"roof\",\n  \"concrete\",\n  \"aircraft\",\n  \"radar\",\n  \"weapon\",\n  \"missile\",\n  \"engine\",\n  \"vehicle\",\n  \"fuel\",\n  \"lab\",\n  \"ship\"\n];\n\nreturn results.map(item => {\n\n  const id = item._id || item.id;\n\n  // ✅ Set Aside extraction\n  let setAside =\n    item.typeOfSetAside?.value ||\n    item.typeOfSetAsideDescription ||\n    item.typeOfSetAside ||\n    item.setAside ||\n    null;\n\n  // ✅ Text blob\n  const textBlob = (\n    (item.title || \"\") + \" \" +\n    (item.description || \"\")\n  ).toLowerCase();\n\n  // ✅ HUBZone detection\nconst isHubzone =\n  textBlob.includes(\"hubzone\") ||\n  (setAside && setAside.toLowerCase().includes(\"hubzone\")) ||\n  item?.typeOfSetAsideDescription?.toLowerCase()?.includes(\"hubzone\") ||\n  item?.typeOfSetAside?.value?.toLowerCase()?.includes(\"hubzone\");\n\n  // ============================\n  // ✅ NAICS HANDLING\n  // ============================\n\n  let naicsRaw = item.naicsCode || item.naics || \"\";\n  let naicsList = [];\n\n  if (Array.isArray(naicsRaw)) {\n    naicsList = naicsRaw.map(n => {\n      if (typeof n === \"object\") return String(n.code || \"\");\n      return String(n);\n    });\n\n  } else if (typeof naicsRaw === \"object\" && naicsRaw !== null) {\n    naicsList = [String(naicsRaw.code || \"\")];\n\n  } else {\n    naicsList = [String(naicsRaw)];\n  }\n\n  naicsList = naicsList.filter(n => n);\n\n  // ============================\n  // ✅ KEYWORD DETECTION\n  // ============================\n\n  const hasITKeyword = IT_KEYWORDS.some(k => textBlob.includes(k));\n\n  const isClearlyNonIT = NON_IT_KEYWORDS.some(k =>\n    textBlob.includes(k)\n  );\n\n  // ============================\n  // ✅ FINAL IT LOGIC (UPDATED 🔥)\n  // ============================\n\n const isIT =\n  !isClearlyNonIT &&\n  (\n    // Strong IT signal\n    naicsList.some(n =>\n      IT_NAICS.some(code => n.startsWith(code))\n    ) ||\n    (\n      // Keyword must be strong (not just \"system\")\n      hasITKeyword &&\n      (\n        textBlob.includes(\"software\") ||\n        textBlob.includes(\"cloud\") ||\n        textBlob.includes(\"data\") ||\n        textBlob.includes(\"cyber\")\n      )\n    )\n  );\n\n  return {\n    json: {\n      publishDate: item.publishDate || null,\n      responseDate: item.responseDeadLine || null,\n      title: item.title || null,\n      description: item.description || null,\n      noticeId: item.noticeId || null,\n\n      department: item.organizationHierarchy?.[0]?.name || null,\n      office: item.organizationHierarchy?.slice(-1)[0]?.name || null,\n\n      type: item.type?.value || null,\n\n      city: item.organizationHierarchy?.slice(-1)[0]?.address?.city || null,\n      state: item.organizationHierarchy?.slice(-1)[0]?.address?.state || null,\n\n      // ✅ CLEAN OUTPUT\n      naics: naicsList.length ? naicsList.join(\", \") : null,\n      psc: item.classificationCode || null,\n\n      // ✅ FLAGS\n      setAside: setAside,\n      isHubzone: isHubzone,\n      isIT: isIT,\n      hasITKeyword: hasITKeyword,\n\n      url: id\n        ? `https://sam.gov/workspace/contract/opp/${id}/view`\n        : null\n    }\n  };\n});"
      },
