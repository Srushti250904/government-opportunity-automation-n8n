      "parameters": {
        "url": "=https://sam.gov/api/prod/sgs/v1/search/?index=opp&page={{$json.page}}&size=25&q=HUBZone OR \"HUBZone Small Business\" OR HUBZone set-aside&is_active=true",
        "sendHeaders": true,
