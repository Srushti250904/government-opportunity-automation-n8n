    {
      "parameters": {
        "jsCode": "const existing = new Set();\n\nfor (const item of items) {\n  const title = (item.json.title || '')\n    .toLowerCase()\n    .replace(/[^\\w\\s]/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  const url = (item.json.url || '')\n    .toLowerCase()\n    .trim();\n\n  const key = title + \"_\" + url;\n\n  if (title && url) {\n    existing.add(key);\n  }\n}\n\nreturn [\n  {\n    json: {\n      existingKeys: Array.from(existing)\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -384,
        432
      ],
      "id": "88296651-4873-4f9c-a355-3331c322bb12",
      "name": "Store existing keys"
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst existingKeys = new Set(items[0].json.existingKeys);\n\nconst output = [];\n\nfor (const item of items) {\n  const key = item.json.uniqueKey;\n\n  if (!key) continue;\n\n  // skip if already in sheet\n  if (existingKeys.has(key)) continue;\n\n  // skip duplicates in same run\n  if (seen.has(key)) continue;\n\n  seen.add(key);\n  output.push(item);\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
