    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  let raw = \"\";\n\n  // ✅ Get AI response\n  if (item.json.output?.[0]?.content?.[0]?.text) {\n    raw = item.json.output[0].content[0].text;\n  }\n\n  // 🔥 CLEAN MARKDOWN\n  raw = raw\n    .replace(/```json/g, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  let ai = {};\n  try {\n    ai = JSON.parse(raw);\n  } catch (e) {\n    ai = { isIT: false, isHubzone: false, confidence: 0 };\n  }\n\n  // ✅ IMPORTANT: USE ORIGINAL DATA\n  const original = item.json;\n\n  return {\n    json: {\n      // 🔥 KEEP ORIGINAL FIELDS\n      publishDate: original.publishDate,\n      title: original.title,\n      description: original.description,\n      noticeId: original.noticeId,\n      department: original.department,\n      office: original.office,\n      responseDate: original.responseDate,\n      type: original.type,\n      city: original.city,\n      state: original.state,\n      url: original.url,\n\n      // ✅ AI FIELDS\n      ai_isIT: ai.isIT,\n      ai_isHubzone: ai.isHubzone,\n      ai_confidence: ai.confidence\n    }\n  };\n});"
      },
